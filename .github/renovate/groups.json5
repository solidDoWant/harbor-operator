{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Groups, then the digest-only group that overrides them",
  packageRules: [
    {
      description: "Harbor's component images for one test Harbor move together: mixed patch versions of core, jobservice, registry and portal aren't a release Harbor tests",
      groupName: "harbor 2.15 test images",
      matchFileNames: ["test/harbor/values.yaml"],
      matchPackageNames: ["ghcr.io/goharbor/**", "mirror.gcr.io/goharbor/**"],
      group: { commitMessageTopic: "{{{groupName}}}" },
    },
    {
      description: "Same for the second matrix entry",
      groupName: "harbor 2.14 test images",
      matchFileNames: ["test/harbor/values-2.14.yaml"],
      matchPackageNames: ["ghcr.io/goharbor/**", "mirror.gcr.io/goharbor/**"],
      group: { commitMessageTopic: "{{{groupName}}}" },
    },
    {
      description: "Go modules: one PR",
      groupName: "go modules",
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Kubernetes libraries move together (client-go, apimachinery, api and controller-runtime pin each other)",
      groupName: "kubernetes",
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "GitHub Actions: one PR",
      groupName: "github actions",
      matchManagers: ["github-actions"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },

    // After every group rule, so it takes image digest-only updates out of their groups.
    {
      description: "Image digest-only updates (same tag, new digest): one PR, held for Dashboard approval",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      groupName: "digest updates",
      groupSlug: "digest-updates",
      group: { commitMessageTopic: "digests" },
      dependencyDashboardApproval: true,
    },
  ],
}
