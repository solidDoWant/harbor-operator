{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Managers: gomod (go.mod), github-actions, nix (flake.lock), and later
  // helm-values and Dockerfiles as the repository grows.
  // Policy is split by topic under .github/renovate/.
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":timezone(America/Chicago)",
    // Applied in this order, then the packageRules below. local> presets are
    // read from the default branch.
    "local>solidDoWant/harbor-operator//.github/renovate/safety.json5",
    "local>solidDoWant/harbor-operator//.github/renovate/groups.json5",
    "local>solidDoWant/harbor-operator//.github/renovate/labels.json5",
  ],

  // Hold new releases briefly (supply-chain safety, chained hotfix releases).
  // timestamp-optional: registries without release timestamps would be held forever.
  minimumReleaseAge: "3 days",
  // cspell:words Behaviour
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // Expected outcome of the above; keep it out of the repository-problems list.
  logLevelRemap: [
    {
      matchMessage: "/did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional/",
      newLogLevel: "debug",
    },
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  // Tags can be re-pushed; a digest pins the exact content.
  pinDigests: true,

  // Replaces config:recommended's list, so the defaults are repeated.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    ".claude/**",
    "**/docs/**",
  ],

  // Off by default upstream. Locked flake inputs only move through
  // lockFileMaintenance (`nix flake update`).
  nix: { enabled: true, lockFileMaintenance: { enabled: true } },
  // Opens only when ticked on the Dependency Dashboard, not every week.
  lockFileMaintenance: { dependencyDashboardApproval: true },

  postUpdateOptions: ["gomodTidy"],

  // Images pinned in Go constants, shell scripts and the e2e manifests, which
  // no built-in manager reads: registry/name:tag@sha256:digest.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^internal/.+\\.go$/", "/^test/.+\\.(go|sh|ya?ml)$/", "/^scripts/.+\\.sh$/"],
      matchStrings: ["(?<depName>(?:mirror\\.gcr\\.io|ghcr\\.io|quay\\.io)/[a-z0-9._/-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      datasourceTemplate: "docker",
    },
  ],

  packageRules: [
    // Last so it overrides any preset rule. Renovate never merges by itself:
    // the agent scheduler routes its PRs (renovate_prs) and arms green ones.
    {
      description: "Automerge disabled for everything",
      matchPackageNames: ["*"],
      automerge: false,
    },
  ],
}
